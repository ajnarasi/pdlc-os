# Anthropic API key (server-side default; users can also paste their own in
# Settings and that override is per-request). On Vercel, set in
# Project Settings → Environment Variables, scoped to Production + Preview.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional model overrides (default: claude-sonnet-4-6)
PDLC_ANTHROPIC_MODEL=claude-sonnet-4-6
PDLC_ANTHROPIC_MAX_TOKENS=16384

# --- Vercel KV (auto-injected when you provision a KV database from the
# Vercel dashboard. DO NOT commit real values; this is for reference only.)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Local dev only — overrides the brain filesystem fallback location.
# (Ignored when KV_REST_API_URL is set.)
# PDLC_BRAIN_DIR=/absolute/path/to/brains
